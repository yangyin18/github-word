# 数据库（开发用 SQLite，生产可改用 PostgreSQL）
DATABASE_URL=sqlite:///./data.db

# ========== GitHub ==========
# 可选，提升 API 速率限制 60→5000次/小时；发布 PR 评论必填
GITHUB_TOKEN=

# GitHub App（可选，生产推荐；配了则优先用 App 鉴权）
GITHUB_APP_ID=0
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# GitHub OAuth（用户登录 + 一键提 PR）
# 在 GitHub App 设置页获取 Client ID / Client Secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 回调地址需在 GitHub App 中配置一致
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/auth/callback
# Session 签名密钥，生产环境务必修改
SESSION_SECRET=change-me-in-production-please-use-random-string

# ========== 翻译引擎 ==========
# 可选值：mock / openrouter / google / deepl
TRANSLATOR_PROVIDER=mock

# OpenRouter（OpenAI 兼容接口，可调用多种模型做翻译）
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Translate
GOOGLE_API_KEY=

# DeepL
DEEPL_API_KEY=

# 服务端口
PORT=8000
